# Copia este fichero a .env y cambia los secretos antes de desplegar.
POSTGRES_DB=openhr
POSTGRES_OWNER_USER=openhr_owner
POSTGRES_OWNER_PASSWORD=cambia-esto-owner
OPENHR_APP_DB_PASSWORD=cambia-esto-app

# Secreto para firmar las sesiones (mínimo 32 caracteres aleatorios).
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
# Clave para cifrar los secretos MFA (32 bytes en base64: openssl rand -base64 32).
ENCRYPTION_KEY=

# Opcional pero recomendado si el servidor es accesible desde la red: la pantalla de
# configuración inicial pedirá este valor (openssl rand -hex 16).
SETUP_TOKEN=

# URL pública de la web (se usa en los enlaces de los emails).
PUBLIC_URL=http://localhost:3000

# Correo saliente. En desarrollo, Mailpit captura todo en http://localhost:8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM="OpenHR <no-reply@openhr.local>"

# Avisos push en el navegador (opcional). Genera las claves con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:rrhh@tu-empresa.es


# Sello de tiempo RFC 3161 para los sellos del registro de jornada (opcional). Una autoridad
# de sellado firma la huella de cada sello; por ejemplo https://freetsa.org/tsr
TSA_URL=

# Antivirus para los ficheros subidos (opcional). Arranca ClamAV con
# "docker compose --profile antivirus up -d" y pon CLAMAV_HOST=clamav
CLAMAV_HOST=
